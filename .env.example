# Copy this file to .env and fill in your own values. Never commit .env.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=paste-your-key-here
LLM_MODEL=gemini-flash-latest

# The database (Session 5)
# Without DATABASE_URL, the app uses a SQLite file: data/clinic.db
# For PostgreSQL in Docker: choose a password, then remove the # before DATABASE_URL and use the same password
POSTGRES_PASSWORD=choose-a-password
# DATABASE_URL=postgresql+asyncpg://clinic:choose-a-password@localhost:5432/clinic

# Optional (these have defaults)
# LOG_LEVEL=INFO
# LLM_TIMEOUT_SECONDS=30
# PROMPT_TOKENS_WARNING=3000
