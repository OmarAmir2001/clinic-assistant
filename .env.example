# Copy this file to .env and fill in your own values. Never commit .env.

# The LLM: one of the blocks below (Session 8). The code is the same; only these lines change.
# Cloud: Gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=paste-your-key-here
LLM_MODEL=gemini-flash-latest
# Local: Ollama on your laptop (first: ollama pull qwen2.5:3b). Slower on a laptop CPU, so give it more time.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b
# LLM_TIMEOUT_SECONDS=120
# Cloud: Groq, free with rate limits (one key per student). Pick a model that supports tool use at console.groq.com.
# Not yet run with this project: try labs.booking_flow once before class.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=paste-your-groq-key
# LLM_MODEL=a-model-from-the-groq-console

# The database: PostgreSQL in Docker (from Session 7, search needs it). Use the same password in both lines.
POSTGRES_PASSWORD=choose-a-password
DATABASE_URL=postgresql+asyncpg://clinic:choose-a-password@localhost:5432/clinic

# Optional (these have defaults)
# LOG_LEVEL=INFO
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=1
# LLM_TEMPERATURE=0
# ANSWER_PROMPT_VERSION=v2   # a folder in app/prompts/answer/
# AGENT_PROMPT_VERSION=v1    # a folder in app/prompts/agent/ (Session 9)
# AGENT_MAX_STEPS=5           # model calls per patient message, at most
# AGENT_TOKEN_BUDGET=20000    # tokens per patient message, at most
# AGENT_HISTORY_MESSAGES=30   # how many stored messages the model sees again
# PROMPT_TOKENS_WARNING=3000
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1   # 10x faster, less accurate (Session 7)
# RERANK_THRESHOLD=0.05   # measure it again with labs/threshold.py if you change the reranker
# CLINIC_API_URL=http://localhost:8000   # where the chat page (ui/app.py) finds the API (Session 10)
# UI_TIMEOUT_SECONDS=120                 # the most the chat page waits between two events
